{
  "expo": {
    "name": "BOMedia",
    "slug": "bomedia-sales-mgt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/BOmedia logo Icon.png",
    "scheme": "bomediasalesmgt",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/bomedia-logo.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#121212"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
